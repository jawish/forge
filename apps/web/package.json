{
  "name": "@forge/web",
  "version": "0.0.0",
  "private": true,
  "description": "Forge web Worker — TanStack Start (UI + tRPC client), no DO bindings (docs/09 §3).",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo 'web unit tests (Vitest) added with the React components' && exit 0",
    "test:unit": "echo 'web unit tests added with the React components' && exit 0",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@forge/control-plane": "workspace:*",
    "@forge/domain": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.34",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260623.1",
    "@playwright/test": "1.62.1",
    "@tanstack/start-vite-plugin": "1.91.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "wrangler": "4.117.0"
  }
}
