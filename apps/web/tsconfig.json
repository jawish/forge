{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "vite/client", "node"],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@forge/control-plane": ["../../apps/control-plane/src/index.ts"],
      "@forge/control-plane/*": ["../../apps/control-plane/src/*"],
      "@forge/control-plane/router": ["../../apps/control-plane/src/api/router.ts"],
      "@forge/domain": ["../../packages/domain/src/index.ts"],
      "@forge/domain/*": ["../../packages/domain/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
